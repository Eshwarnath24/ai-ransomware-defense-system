# ── Frontend Environment Variables ──
# Copy this file to .env.local and customize for your deployment.
# For local development, no .env is needed (defaults to localhost:8000).

# Backend API base URL (REST endpoints)
# For Render deployment: https://your-app-name.onrender.com
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL (live pipeline stream)
# For Render deployment: wss://your-app-name.onrender.com/ws/live
VITE_WS_URL=ws://localhost:8000/ws/live
